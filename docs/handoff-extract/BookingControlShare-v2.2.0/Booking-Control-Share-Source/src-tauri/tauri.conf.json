{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Booking Control Share",
  "version": "2.2.0",
  "identifier": "com.bookingcontrol.share",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm dev",
      "cwd": "../ui"
    },
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": {
      "script": "pnpm build",
      "cwd": "../ui"
    },
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Booking Control Share",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "compression": "zlib"
      }
    }
  }
}
