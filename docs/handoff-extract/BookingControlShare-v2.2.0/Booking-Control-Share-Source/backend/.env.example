HOST=127.0.0.1
PORT=8002
RELOAD=false
API_KEY=
DATABASE_URL=sqlite+aiosqlite:///./ttdapi.db

ENVIRONMENT=dev

# Worker pool
MAX_CONCURRENT=5
TASK_TIMEOUT_SECONDS=300

# Browser
# CloakBrowser free tier only - no license key, no geoip.
HEADLESS=false
BROWSER_TIMEOUT_MS=30000
BROWSER_LOCALE=en-IN
TTD_LOGIN_URL=https://tirupatibalaji.ap.gov.in/#/userLogin

# Optional proxy support for your own infrastructure
USE_PROXY=false

# Manual-fill instance runner (uv run ttdapi --instances)
# If unset, TTD_LOGIN_URL above is used instead.
TTD_FORM_URL=
RELEASE_POLL_INTERVAL_SECONDS=0.5
# How often each instance logs its release/server-time countdown
RELEASE_STATUS_LOG_INTERVAL_SECONDS=15

# Fully-automated booking mode (POST /register/ttd with a payload)
# How many times to retry login if the captcha OCR is misread
LOGIN_CAPTCHA_MAX_ATTEMPTS=3

# Task logs are held in memory; no remote logging or cloud control.
LOG_LEVEL=INFO
SERVICE_NAME=booking-control-share
