NODE_ENV=production
PORT=4000
APP_VERSION=1.0.0

# MongoDB Atlas — restrict IP to EC2 egress + use dedicated DB user (readWrite only)
MONGODB_URI=mongodb+srv://darshandesk_app:REPLACE@cluster0.xxxxx.mongodb.net/darshandesk?retryWrites=true&w=majority

# Strong random — rotate on compromise
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32

# Exact dashboard origins (comma-separated, no wildcards in production)
CORS_ORIGINS=https://app.example.com
CLIENT_ORIGIN=https://app.example.com

TRUST_PROXY_HOPS=1
JSON_BODY_LIMIT=1mb

# Never seed demo operators in production
SEED_ON_START=false

# Agency license gate (optional)
LICENSE_ENFORCE=true

# TTD adapter — mock until written approval
TTD_INTEGRATION_MODE=mock
TTD_INTEGRATION_ENABLED=false
TTD_API_BASE_URL=https://tirupatibalaji.ap.gov.in

EXTENSION_ACCESS_TTL_SEC=900

# API hardening
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=20
REQUEST_TIMEOUT_MS=30000
AUDIT_LOG=true

# Optional monitoring
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Mock QA signals off in production
ALLOW_MOCK_SIGNALS=false