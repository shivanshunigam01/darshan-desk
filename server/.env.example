PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/darshan-desk
JWT_SECRET=change-me-in-production
CLIENT_ORIGIN=http://localhost:5173
# Comma-separated CORS allowlist (production)
# CORS_ORIGINS=https://app.example.com
# chrome-extension:// origins are always allowed for DarshanDesk MV3 pairing (see env.js)

NODE_ENV=development
# LICENSE_ENFORCE=false

# TTD SRIVANI adapter (server-side only — never expose tokens to the browser)
TTD_API_BASE_URL=https://tirupatibalaji.ap.gov.in
# approved = live https://tirupatibalaji.ap.gov.in/dms/darshansummarySrivaniCurrentDay (server proxy only)
# mock = dev fixtures without TTD login
TTD_INTEGRATION_MODE=approved
TTD_INTEGRATION_ENABLED=false
# Paste portal session token from browser devtools after login (never commit real tokens)
# TTD_INTEGRATION_AUTH_TOKEN=
TTD_INTEGRATION_MIN_REFRESH_MS=60000
# TTD_MOCK_SCENARIO=default

# Extension short-lived access tokens (seconds)
EXTENSION_ACCESS_TTL_SEC=900